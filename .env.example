# Copy to .env.local and fill in. Never commit .env.local.

# The database the app and `npm run db:*` commands use. Locally: Docker Postgres (docker compose up -d db).
# On Netlify, set DATABASE_URL to Supabase → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/square_lounge

# Live database for `npm run supabase:*` commands from this PC: Supabase → Connect → "Session pooler" URI
# (port 5432) with your database password filled in. Leave empty until you have a Supabase project.
SUPABASE_DB_URL=

# Separate database for integration tests; it is migrated and wiped by the test run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/square_lounge_test

# Used by `npm run db:seed` / `supabase:seed` to create the first admin account.
# The example password below is public: `supabase:seed` refuses it. Use a strong one for Supabase.
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=change-me-now

# Shared password for all demo accounts created by `npm run db:seed-demo` / `supabase:seed-demo`.
DEMO_PASSWORD=

# Protects /api/cron/expire-vouchers; the Netlify scheduled function sends it as a bearer token. Any long random string.
CRON_SECRET=
