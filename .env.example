# Copy to .env.local and fill in. Never commit .env.local.

# Local Docker Postgres (docker compose up -d db).
# On Supabase: Project → Connect → "Transaction pooler" URI (port 6543). The app sets prepare: false for it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/square_lounge

# Separate database for integration tests; it is migrated and wiped by the test run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/square_lounge_test

# Used once by `npm run db:seed-admin` to create the first admin account.
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=change-me-now
